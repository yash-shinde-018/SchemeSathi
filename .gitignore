# ==========================================
# SchemeSathi Root .gitignore
# ==========================================

# Virtual Environments
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
backend/env/

# Node & Frontend dependencies
node_modules/
schemesathi-landing/node_modules/
.npm/

# Build Outputs
dist/
schemesathi-landing/dist/
build/
*.egg-info/
develop-eggs/
.eggs/

# Environment Files (Keep .env.example tracked)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
schemesathi-landing/.env
schemesathi-landing/.env.*
!schemesathi-landing/.env.example
*.local

# Database Files
*.db
*.sqlite
*.sqlite3
schemes.db
instance/
backend/instance/

# Python Bytecode and Cache
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
*.so

# Test & Coverage Caches
.pytest_cache/
backend/.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage/

# Logs
*.log
logs/
backend/logs/
npm-debug.log*
yarn-debug.log*

# IDE & Editor Settings
.vscode/
.idea/
.kiro/
*.swp
*.swo
*~

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Temporary and Scratch Directories
scratch/
*.tmp

