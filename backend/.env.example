# Flask Environment
FLASK_ENV=development
FLASK_APP=run.py
DEBUG=True

# Database Configuration - Neon DB
# Replace with your actual Neon DB connection string from neon.tech
DATABASE_URL=postgresql://user:password@ep-xxxxxx.us-east-1.neon.tech/schemesathi?sslmode=require

# Session Configuration
SESSION_SECRET=your-secret-key-change-in-production
BCRYPT_LOG_ROUNDS=12

# JWT Configuration (optional, if using tokens)
JWT_SECRET_KEY=dev-secret-key-change-in-production

# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=5000

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Application Configuration
APP_NAME=SchemeSathi
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Email Configuration (optional - for future notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
